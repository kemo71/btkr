# Btkr Valley — environment variables
#
# Copy to `.env.local` for development. NEVER commit `.env.local`.

# -- Database -----------------------------------------------------------------
# Local Postgres (matches infra/docker-compose.yml credentials):
DATABASE_URL=postgres://btkr:btkr_dev_pwd@localhost:5432/btkr

# -- Cache --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -- BYOK Key Encryption Key (KEK) --------------------------------------------
# 32 random bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# In PRODUCTION this comes from the KMS / HSM in the KSA region, NEVER a file.
BYOK_KEK=

# -- Federated SSO ------------------------------------------------------------
# Public origin of this app (used to build redirect / ACS URLs):
APP_ORIGIN=http://localhost:3000
# Signs the short-lived OIDC login-state cookie. 32+ random bytes:
#   openssl rand -base64 32
AUTH_STATE_SECRET=
# Which mechanism this deployment uses: "oidc" (default) or "saml"
SSO_MECHANISM=oidc
# OIDC (Authorization Code + PKCE)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# SAML 2.0 (only if SSO_MECHANISM=saml)
SAML_IDP_ENTITY_ID=
SAML_SP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_CERT=
# Roles that must satisfy MFA even if the IdP didn't assert it:
MFA_REQUIRED_ROLES=admin,stakeholder

# -- Demo mode (production-safe) ----------------------------------------------
# Set to "1" to enable the demo role picker at /auth/demo on a deployment
# where an IdP isn't configured. When on:
#   - "/auth/login" (no IdP) and the header's "Try the demo" link -> /auth/demo
#   - signing in there creates a REAL session bound to a seeded user with a
#     REAL role — RBAC / audit / CSP all still apply
#   - a loud "DEMO MODE" banner shows on every page
#   - `pnpm db:seed` will create the demo users even in production
# OFF by default. Unlike BTKR_DEV_USER, this is meant to be set in production
# — but only on a deployment where exposing the seeded data is acceptable.
BTKR_DEMO_MODE=

# -- Dev auth shim ------------------------------------------------------------
# Only used when no SSO is configured AND NODE_ENV != production. Email of a
# seeded user (`pnpm db:seed`): admin@ / stakeholder@ / employee@ / auditor@
# ksaa.gov.sa. In dev you can also switch via the /dev page (sets a cookie).
# Must be UNSET in production (use BTKR_DEMO_MODE there instead).
BTKR_DEV_USER=admin@ksaa.gov.sa
