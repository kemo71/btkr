# Btkr Valley — environment variables
#
# Copy to `.env.local` for development. NEVER commit `.env.local`.

# -- Database -----------------------------------------------------------------
# Local Postgres (matches infra/docker-compose.yml credentials):
DATABASE_URL=postgres://btkr:btkr_dev_pwd@localhost:5432/btkr

# -- Cache --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -- BYOK Key Encryption Key (KEK) --------------------------------------------
# 32 random bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# In PRODUCTION this comes from the KMS / HSM in the KSA region, NEVER a file.
BYOK_KEK=

# -- Dev auth shim ------------------------------------------------------------
# Email of the seeded user whose identity Claude / the app assumes during dev.
# Options after `pnpm db:seed`:
#   admin@ksaa.gov.sa       — Administrator
#   stakeholder@ksaa.gov.sa — Gate decisions, dashboards
#   employee@ksaa.gov.sa    — Default contributor
#   auditor@ksaa.gov.sa     — Read-only
# Must be UNSET in production (real SSO session is used instead).
BTKR_DEV_USER=admin@ksaa.gov.sa
